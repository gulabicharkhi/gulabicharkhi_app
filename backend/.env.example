# ========================================
# Gulabi Charkhi - Backend Environment
# ========================================
# Is file ko copy karke .env banao:
#   cp .env.example .env

# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/gulabi_charkhi

# JWT Secret
JWT_SECRET=gulabi_charkhi_super_secret_key_change_in_production
JWT_EXPIRES_IN=30d

# Email (Gmail App Password)
EMAIL_USER=gulabicharkhi@gmail.com
EMAIL_PASS=xxxx xxxx xxxx xxxx

# App Links
WEB_INVITE_BASE_URL=http://192.168.0.150/join
APP_INVITE_BASE_URL=gulabicharkhi://join
APP_NAME=Gulabi Charkhi
PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.gulabicharkhi.app
APP_STORE_URL=https://apps.apple.com/app/gulabi-charkhi/idXXXXXXXXX

# ========================================
# FIREBASE — Push Notifications
# ========================================
# Firebase Console → Project Settings → Service Accounts
# "Generate new private key" → JSON file download hogi
#
# OPTION A (Recommended for deployment - Render/Railway/Heroku):
# JSON ka content ek line mein paste karo:
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"YOUR_PROJECT_ID","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk-xxx@YOUR_PROJECT.iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"..."}
#
# OPTION B (Local development):
# File path set karo (file backend/ folder mein rakho):
# FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
